# Public Supabase settings for the AI Skill waitlist.
# The anon key is meant to be public. Row Level Security allows an
# anonymous visitor to insert a row and nothing else.
#
# This site is a static export, so these are read at build time and
# baked into the pages. Set them before `npm run build` (locally in
# .env.local, and in the Cloudflare Pages project for a deploy).
# Never commit .env.local. Never put the service-role key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
